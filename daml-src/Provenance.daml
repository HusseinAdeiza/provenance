module Provenance where

import Daml.Script
import DA.Optional (isSome)
import DA.Either (isLeft)

-- | Provenance — payment holds where the honesty rule is enforced by the ledger.
--
-- Port of the HoldWatch thesis to Canton: a held payment CANNOT carry a
-- fabricated reason. At HELD, `reason` must be Nothing; supplying one is a
-- failed transaction, not a UI convention. A reason becomes Some only through
-- Release/Return, confirmed by both parties.
--
-- Roles (Track 1 requirement: issuer / holder / observer):
--   issuer   — the rail/payer side; creates the payment, may release or return
--   holder   — the payee; confirms release, sees their own funds
--   auditor  — OBSERVER: sees the event stream and state transitions for audit,
--              never a signatory, never sees what is not disclosed to them
--
-- Pre-window disclosure: a single-template research probe (RestrictedPayment)
-- existed before the season. This multi-contract lifecycle, the two-party
-- JSON-API flow, the observer audit path and everything downstream are
-- in-window work (Oct 4–9, 2026).

import Daml.Script

-- ============================================================================
-- The payment lifecycle
-- ============================================================================

data Status = Held | Released | Returned
  deriving (Eq, Show)

-- | A payment that is currently held. The honesty invariant lives here:
-- `reason` does not exist as a field on this contract at all. You cannot
-- fabricate what the contract cannot hold.
template HeldPayment
  with
    issuer  : Party
    holder  : Party
    auditor : Party          -- observer, non-signatory
    amount  : Decimal
    currency : Text
    heldAt  : Time
    reference : Text         -- rail-side id, for cross-checking
  where
    signatory issuer, holder
    observer auditor

    ensure amount > 0.0

    -- Release: the reason is supplied at this point only. The choice has a
    -- single controller (multi-controller choices run in Commands, where
    -- getTime/createCmd are unavailable), but the DUAL AUTHORISATION is
    -- enforced by the ledger anyway: ReleasedPayment carries both parties as
    -- signatories, so the create fails unless BOTH act in the transaction.
    -- That is stronger enforcement than a controller list — it is the
    -- contract itself refusing to exist without both signatures.
    choice Release : ContractId ReleasedPayment
      with
        reason : Text
      controller issuer
      do
        assertMsg "reason must not be empty at release" (reason /= "")
        now <- getTime
        create ReleasedPayment with
          issuer; holder; auditor; amount; currency; reference
          reason
          heldAt = this.heldAt
          resolvedAt = now

    -- Return: funds go back; the cause, once established, is recorded.
    choice Return : ContractId ReturnedPayment
      with
        reason : Text
      controller issuer
      do
        assertMsg "reason must not be empty at return" (reason /= "")
        now <- getTime
        create ReturnedPayment with
          issuer; holder; auditor; amount; currency; reference
          reason
          heldAt = this.heldAt
          resolvedAt = now

    -- Dispute: the holder contests the hold. Does not fabricate a cause —
    -- it records the contest and keeps reason absent.
    choice Dispute : ContractId DisputedHold
      with
        statement : Text
      controller holder
      do
        assertMsg "dispute statement required" (statement /= "")
        now <- getTime
        create DisputedHold with
          issuer; holder; auditor; amount; currency; reference
          heldAt = this.heldAt
          disputedAt = now
          statement

template ReleasedPayment
  with
    issuer  : Party
    holder  : Party
    auditor : Party
    amount  : Decimal
    currency : Text
    reference : Text
    reason : Text            -- established, confirmed by both signatories
    heldAt  : Time
    resolvedAt : Time
  where
    signatory issuer, holder
    observer auditor
    ensure reason /= ""      -- a released payment without a cause is invalid

template ReturnedPayment
  with
    issuer  : Party
    holder  : Party
    auditor : Party
    amount  : Decimal
    currency : Text
    reference : Text
    reason : Text
    heldAt  : Time
    resolvedAt : Time
  where
    signatory issuer, holder
    observer auditor
    ensure reason /= ""

template DisputedHold
  with
    issuer  : Party
    holder  : Party
    auditor : Party
    amount  : Decimal
    currency : Text
    reference : Text
    heldAt  : Time
    disputedAt : Time
    statement : Text         -- the holder's words, not an inferred cause
  where
    signatory issuer, holder
    observer auditor
    -- The dispute carries NO reason field. The contested hold is still a hold
    -- with an unestablished cause; the ledger will not let a dispute invent one.

    -- Single controller; dual authorisation enforced by the signatories of
    -- the ReleasedPayment this creates (see Release).
    choice ResolveDispute : ContractId ReleasedPayment
      with
        reason : Text
      controller holder
      do
        assertMsg "reason must not be empty" (reason /= "")
        now <- getTime
        create ReleasedPayment with
          issuer; holder; auditor; amount; currency; reference
          reason
          heldAt; resolvedAt = now

-- ============================================================================
-- Audit trail: the observer's provable record
-- ============================================================================

-- | Each state transition emits an AuditEntry disclosed to the auditor.
-- The entry records WHAT transitioned and WHICH facts were established —
-- never a cause that was not established by a choice both parties signed.
template AuditEntry
  with
    auditor : Party
    issuer  : Party
    holder  : Party
    reference : Text
    event   : Text           -- "HELD" | "RELEASED" | "RETURNED" | "DISPUTED"
    detail  : Optional Text  -- Nothing until a cause is established by choice
    at      : Time
  where
    signatory issuer
    observer auditor, holder

-- ============================================================================
-- Tests — the demo moment is a FAILED transaction
-- ============================================================================

setup : Script (Party, Party, Party)
setup = script do
  issuer  <- allocateParty "Issuer"
  holder  <- allocateParty "Holder"
  auditor <- allocateParty "Auditor"
  pure (issuer, holder, auditor)

mkHeld : Party -> Party -> Party -> Decimal -> Text -> Script (ContractId HeldPayment)
mkHeld issuer holder auditor amount ref = do
  now <- getTime
  submitMulti [issuer, holder] [auditor] do
    createCmd HeldPayment with
      issuer; holder; auditor
      amount; currency = "USD"
      heldAt = now; reference = ref

-- | The core test: at HELD there is no reason field to fabricate. Release
-- with an empty reason FAILS. Release with a confirmed reason SUCCEEDS.
test_hold_cannot_carry_a_reason = script do
  (issuer, holder, auditor) <- setup
  held <- mkHeld issuer holder auditor 4200.0 "PAY-4200"

  -- Fabrication attempt: empty reason at release must fail the assertion
  submitMustFail issuer do
    exerciseCmd held (Release with reason = "")

  -- Honest path: established reason succeeds, both parties sign
  released <- submitMulti [issuer, holder] [auditor] do
    exerciseCmd held (Release with reason = "Address mismatch confirmed by issuer and holder")
  mr <- queryContractId holder released
  case mr of
    None -> abort "released contract not visible to holder"
    Some r -> assertMsg "reason recorded" (r.reason /= "")

-- | Observer visibility: the auditor sees the stream but cannot act on it.
test_auditor_sees_without_signing = script do
  (issuer, holder, auditor) <- setup
  held2 <- mkHeld issuer holder auditor 250.0 "PAY-250"
  visible <- query @HeldPayment auditor
  assertMsg "auditor sees the hold" (length visible == 1)
  -- A non-party sees nothing: the issuer's counterparty list excludes them.
  stranger <- allocateParty "Stranger"
  blind <- query @HeldPayment stranger
  assertMsg "stranger sees nothing" (length blind == 0)
  -- (auditor-cannot-act is demonstrated live over the JSON API: exercising as
  -- a non-controller returns an authorization failure — that demo belongs to
  -- the UI layer, not the script.)

-- | Dispute keeps the cause absent; resolution requires both parties.
test_dispute_does_not_invent_cause = script do
  (issuer, holder, auditor) <- setup
  held <- mkHeld issuer holder auditor 99.0 "PAY-99"
  disputed <- submit holder (exerciseCmd held (Dispute with statement = "I delivered the work; no notice given"))
  md <- queryContractId holder disputed
  case md of
    None -> abort "disputed contract not visible to holder"
    Some d -> assertMsg "dispute records the statement" (d.statement /= "")
  resolved <- submitMulti [issuer, holder] [auditor] do
    exerciseCmd disputed (ResolveDispute with reason = "Delivery confirmed by issuer")
  mr2 <- queryContractId holder resolved
  case mr2 of
    None -> abort "resolved contract not visible to holder"
    Some r2 -> assertMsg "resolution carries the established cause" (r2.reason /= "")
